{
  "name": "antares",
  "productName": "Antares",
  "version": "0.7.35",
  "description": "A modern, fast and productivity driven SQL client with a focus in UX.",
  "license": "MIT",
  "repository": "https://github.com/antares-sql/antares.git",
  "engines": {
    "node": "^24",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "debug": "npm run rebuild:electron && npm run debug-runner",
    "debug-runner": "node scripts/devRunner.js --remote-debug",
    "compile": "npm run compile:main && npm run compile:workers && npm run compile:renderer",
    "compile:main": "webpack --mode=production --config webpack.main.config.js",
    "compile:workers": "webpack --mode=production --config webpack.workers.config.js",
    "compile:renderer": "webpack --mode=production --config webpack.renderer.config.js",
    "build": "cross-env NODE_ENV=production npm run compile && electron-builder --publish never",
    "build:appx": "npm run build -- --win appx",
    "rebuild:electron": "rimraf ./dist &&  npm run postinstall && npm run devtools:install",
    "release": "standard-version",
    "release:beta": "npm run release -- --prerelease beta",
    "devtools:install": "node scripts/devtoolsInstaller",
    "postinstall": "electron-builder install-app-deps",
    "translation:check": "ts-node ./scripts/translationCheck.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test:node -- tests/unit/*.test.ts",
    "test:integration": "npm run test:node -- tests/integration/*.test.ts",
    "test:node": "cross-env ELECTRON_RUN_AS_NODE=1 electron --require ts-node/register --require ./tests/support/paths.js --require ./tests/support/electron-stubs.js --test-reporter=spec --test",
    "test:e2e": "npm run compile && npm run test:e2e-dry",
    "test:e2e-dry": "xvfb-maybe -- playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"./src/**/*.{css,scss,sass,vue}\"",
    "lint:fix": "eslint . --fix && stylelint \"./src/**/*.{css,scss,sass,vue}\" --fix",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "prepare": "husky"
  },
  "author": "Fabio Di Stasio <info@fabiodistasio.it>",
  "main": "./dist/main.js",
  "antares": {
    "devtoolsId": "nhdogjmejiglipccpnnnanhbledajbpd"
  },
  "build": {
    "appId": "com.fabio286.antares",
    "artifactName": "${productName}-${version}-${os}_${arch}.${ext}",
    "asar": true,
    "buildDependenciesFromSource": true,
    "directories": {
      "output": "build",
      "buildResources": "assets"
    },
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist/**/*",
      "node_modules",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "armv7l"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "armv7l"
          ]
        }
      ],
      "icon": "assets/linux",
      "category": "Development"
    },
    "appImage": {
      "license": "./LICENSE",
      "category": "Development"
    },
    "nsis": {
      "license": "./LICENSE",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/icon.ico",
      "oneClick": false,
      "perMachine": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "appx": {
      "displayName": "Antares SQL",
      "backgroundColor": "transparent",
      "showNameOnTiles": true,
      "identityName": "62514FabioDiStasio.AntaresSQLClient",
      "publisher": "CN=1A2729ED-865C-41D2-9038-39AE2A63AA52",
      "applicationId": "FabioDiStasio.AntaresSQLClient"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@fabio286/ssh2-promise": "~1.0.4-b",
    "@faker-js/faker": "~6.1.2",
    "@jamescoyle/vue-icon": "~0.1.2",
    "@mdi/js": "~7.2.96",
    "@turf/helpers": "7.4.0",
    "@vueuse/core": "14.4.0",
    "ace-builds": "~1.34.1",
    "better-sqlite3": "13.0.3",
    "ciaplu": "^2.2.0",
    "cpu-features": "^0.0.10",
    "dompurify": "3.4.14",
    "electron-log": "~5.0.1",
    "electron-store": "~8.1.0",
    "electron-updater": "6.8.9",
    "electron-window-state": "~5.0.3",
    "encoding": "~0.1.13",
    "floating-vue": "5.2.2",
    "json2php": "~0.0.7",
    "leaflet": "~1.7.1",
    "marked": "12.0.0",
    "moment": "~2.30.1",
    "mysql2": "~3.9.7",
    "node-firebird": "~1.1.8",
    "pg": "~8.11.5",
    "pg-query-stream": "~4.2.3",
    "pgsql-ast-parser": "7.2.1",
    "pinia": "~2.1.7",
    "source-map-support": "~0.5.20",
    "spectre.css": "~0.5.9",
    "sql-formatter": "15.8.2",
    "sql-highlight": "6.1.0",
    "v-mask": "~2.3.0",
    "vue": "3.5.41",
    "vue-i18n": "11.4.8",
    "vuedraggable": "~4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/leaflet": "~1.7.9",
    "@types/node": "24.13.3",
    "@types/pg": "~8.6.5",
    "@types/ssh2": "~1.11.6",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "all-contributors-cli": "~6.20.0",
    "chalk": "~4.1.2",
    "cross-env": "10.1.0",
    "css-loader": "7.1.4",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "eslint": "10.9.0",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-vue": "10.10.0",
    "file-loader": "~6.2.0",
    "html-webpack-plugin": "~5.5.0",
    "husky": "~9.0.11",
    "mini-css-extract-plugin": "~2.4.5",
    "node-loader": "~2.0.0",
    "playwright": "1.62.1",
    "playwright-core": "1.62.1",
    "progress-webpack-plugin": "~1.0.12",
    "rimraf": "6.1.3",
    "sass": "~1.42.1",
    "sass-loader": "~12.3.0",
    "standard-version": "~9.3.1",
    "stylelint": "17.14.1",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "tree-kill": "~1.2.2",
    "ts-loader": "~9.2.8",
    "ts-node": "~10.9.1",
    "typescript": "6.0.3",
    "unzip-crx-3": "~0.2.0",
    "vue-eslint-parser": "10.4.1",
    "vue-loader": "17.4.2",
    "webpack": "^5.91.0",
    "webpack-cli": "~4.9.1",
    "webpack-dev-server": "~4.11.1",
    "xvfb-maybe": "~0.2.1"
  },
  "optionalDependencies": {
    "dmg-license": "~1.0.11"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "cpu-features": true,
    "playwright": true,
    "ssh2": true,
    "vue-demi": true,
    "fsevents@2.3.2": true,
    "electron@43.4.1": true,
    "electron-winstaller@5.4.0": true,
    "better-sqlite3@13.0.3": true
  },
  "overrides": {
    "nan": "2.28.0"
  }
}
