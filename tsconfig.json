{
  "include": [
    "./src/main/**/*", 
    "./src/renderer/**/*", 
    "./src/common/**/*", 
  ],
  "exclude": ["./src/renderer/libs/ext-language_tools.js", "./tests"],
  "ts-node": {
    "transpileOnly": true
  },
  "compilerOptions": {
    "target": "es2021",
    "allowJs": true,
    "module": "CommonJS",
    "skipLibCheck": true,
    "noImplicitAny": true,
    "jsx": "preserve",
    "types": [
      "node"
    ],
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "paths": {
      "common/*": ["./src/common/*"],
      "@/*": ["./src/renderer/*"],
      "src/*": ["./src/*"],
    }
  }
}