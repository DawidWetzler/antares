{
  "include": [
    "./src/main/**/*", 
    "./src/renderer/**/*", 
    "./src/common/**/*", 
  ],
  "exclude": ["./src/renderer/libs/ext-language_tools.js", "./tests"],
  "ts-node": {
    "transpileOnly": true
  },
  "compilerOptions": {
    "target": "es2021",
    "rootDir": "./",
    "strict": false,
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "noUncheckedSideEffectImports": false,
    "allowJs": true,
    "module": "CommonJS",
    "skipLibCheck": true,
    "noImplicitAny": true,
    "jsx": "preserve",
    "types": [
      "node"
    ],
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "paths": {
      // conf v15 (via electron-store) is exports-map-only with no root "types";
      // moduleResolution node10 cannot see it, so point at the declarations directly.
      "conf": ["./node_modules/conf/dist/source/index.d.ts"],
      "common/*": ["./src/common/*"],
      "@/*": ["./src/renderer/*"],
      "src/*": ["./src/*"],
    }
  }
}